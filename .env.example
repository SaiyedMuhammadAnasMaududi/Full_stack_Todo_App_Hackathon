# Environment variables for AI Todo Chatbot
# Copy this file to .env and fill in your values

# Backend Configuration
DATABASE_URL=postgresql://username:password@host:port/database_name
COHERE_API_KEY=your_cohere_api_key_here
OPENAI_DOMAIN_KEY=your_openai_domain_key_here
BETTER_AUTH_SECRET=your_jwt_secret_here
BACKEND_PORT=8000

# Frontend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_COHERE_API_KEY=your_cohere_api_key_here
NEXT_PUBLIC_BETTER_AUTH_SECRET=your_jwt_secret_here
NEXT_PUBLIC_CHATKIT_URL=your_chatkit_url_here

# MCP Tools Configuration
MCP_TOOLS_ENABLED=true
MCP_TOOLS_API_KEY=your_mcp_tools_api_key_here

# Minikube/Kubernetes Configuration
MINIKUBE_CPUS=2
MINIKUBE_MEMORY=4096mb
KUBERNETES_NAMESPACE=default

# AI Agent Configuration
AI_AGENT_PROVIDER=cohere
AI_AGENT_MODEL=command-r-plus
AI_AGENT_TEMPERATURE=0.7

# Additional Configuration
LOG_LEVEL=INFO
DEBUG=False
NODE_ENV=development